---
import type { MarkdownHeading } from 'astro';
import ArticleEnhancements from '../components/ArticleEnhancements.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TableOfContents from '../components/TableOfContents.astro';
import TagList from '../components/TagList.astro';
import type { Post } from '../lib/posts';
import '../styles/prose.css';
import BaseLayout from './BaseLayout.astro';

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  minutes: number;
  /** Title + id of the linked project, if any. */
  project?: { id: string; title: string };
}

const { post, headings, minutes, project } = Astro.props;
const { title, description, date, updated, kind, tags, draft } = post.data;
---

<BaseLayout title={title} description={description} type="article">
  <article>
    <header class="post-header">
      <p class="meta post-header__meta">
        <FormattedDate date={date} />
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
        <span aria-hidden="true">·</span>
        <span>{kind === 'write-up' ? 'Write-up' : 'Note'}</span>
        {draft && <span class="post-header__draft">Draft</span>}
      </p>
      <h1>{title}</h1>
      <p class="post-header__description">{description}</p>
      {
        project && (
          <p class="meta">
            Part of <a href={`/projects/${project.id}`}>{project.title}</a>
          </p>
        )
      }
      <TagList tags={tags} />
      {
        updated && (
          <p class="meta">
            Updated <FormattedDate date={updated} />
          </p>
        )
      }
    </header>

    <TableOfContents headings={headings} />

    <div class="prose">
      <slot />
    </div>
  </article>

  <nav class="post-footer" aria-label="More writing">
    <a href="/writing">← All writing</a>
  </nav>

  <ArticleEnhancements />
</BaseLayout>

<style>
  .post-header {
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border);
  }

  .post-header__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-bottom: var(--space-2);
  }

  .post-header__draft {
    color: var(--accent);
  }

  .post-header h1 {
    margin-bottom: var(--space-2);
  }

  .post-header__description {
    font-size: var(--text-md);
    color: var(--text-muted);
    margin-bottom: var(--space-2);
  }

  .post-footer {
    margin-top: var(--space-8);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
    font-size: var(--text-sm);
  }
</style>
