---
import type { Post } from '../lib/posts';
import PostCard from './PostCard.astro';

interface Props {
  posts: Post[];
  emptyMessage?: string;
}

const { posts, emptyMessage = 'Nothing published yet.' } = Astro.props;
---

{posts.length > 0 ? posts.map((post) => <PostCard post={post} />) : <p class="empty">{emptyMessage}</p>}

<style>
  .empty {
    color: var(--text-muted);
  }
</style>
